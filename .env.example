# Copy to .env for local Docker Compose usage.
# Do not commit real credentials.

FLAPJACK_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOW_ALL=true
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=false

POSTGRES_DB=registry
POSTGRES_USER=flapjack
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
