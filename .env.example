# Root-level compose defaults (development only)
POSTGRES_DB=registry
POSTGRES_USER=flapjack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

APP_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOW_ALL=1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_ENGINE=django.db.backends.postgresql
DB_NAME=registry
DB_USER=flapjack
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
