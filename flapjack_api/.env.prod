# Example production environment file. Do not commit real secrets.
APP_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-me-with-secure-random-key
DJANGO_ALLOWED_HOSTS=api.example.org
DJANGO_CORS_ALLOW_ALL=0
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.org

DB_ENGINE=django.db.backends.postgresql
DB_NAME=registry
DB_USER=registry_user
DB_PASSWORD=replace-me
DB_HOST=managed-postgres-hostname
DB_PORT=5432

REDIS_HOST=managed-redis-hostname
REDIS_PORT=6379
